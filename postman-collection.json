{
  "info": {
    "name": "TODO API",
    "description": "Pruebas de la API de gestión de tareas (Laboratorio Docker)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Crear tarea (POST)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "http://localhost:3000/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Mi primera tarea\",\n  \"description\": \"Descripción de prueba\"\n}"
        }
      }
    },
    {
      "name": "2. Listar tareas (GET)",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/api/tasks"
      }
    },
    {
      "name": "3. Obtener tarea por ID (GET)",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/api/tasks/COPIAR_ID_AQUI"
      }
    },
    {
      "name": "4. Actualizar tarea (PUT)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "http://localhost:3000/api/tasks/COPIAR_ID_AQUI",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": true\n}"
        }
      }
    },
    {
      "name": "5. Eliminar tarea (DELETE)",
      "request": {
        "method": "DELETE",
        "url": "http://localhost:3000/api/tasks/COPIAR_ID_AQUI"
      }
    }
  ]
}