# Puerto del servidor
PORT=3000

# Cadena de conexion a PostgreSQL
# Render: postgres://usuario:pass@host:5432/tododb
# Docker: postgres://todo:todo123@localhost:5432/tododb
DATABASE_URL=postgres://todo:todo123@localhost:5432/tododb

# Render activa ssl; si tu proveedor lo exige, ponlo a true
# PGSSL=true